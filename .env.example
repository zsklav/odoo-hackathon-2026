# Prisma — pooled connection (port 6543) for the app, from Project Settings > Database
# Use the "Connection pooling" URI, with ?pgbouncer=true appended
DATABASE_URL=REPLACE_WITH_YOUR_SUPABASE_POOLED_CONNECTION_STRING

# Prisma — direct/session connection (port 5432), required for `prisma db push`
# and migrations since the pgbouncer pooler doesn't support schema operations.
DIRECT_URL=REPLACE_WITH_YOUR_SUPABASE_DIRECT_CONNECTION_STRING

# SERVER-ONLY SECRET — never prefix with NEXT_PUBLIC_, never expose client-side.
# Signs/verifies session JWTs (src/lib/auth/jwt.ts). Generate a long random
# value yourself, e.g. `openssl rand -base64 48` — do not reuse a placeholder.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
